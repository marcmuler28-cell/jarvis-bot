# ============================================================
# JARVIS BOT - environment template
# Copy to .env and fill in your own values. NEVER commit .env.
# ============================================================

# --- Cibertec platform (cibertec.py / test_login.py) ---
USER=your_student_id@cibertec.edu.pe
PASS=your_password_here
OPERA_PATH=C:\Path\To\opera.exe

# --- WhatsApp Cloud API (whatsapp_bot.py) ---
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_string

# --- Local MySQL memory (database.py) ---
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# --- Local LLM (Ollama / llama.cpp) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
